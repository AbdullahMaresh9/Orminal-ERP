// Alostaz Accounting ERP - Prisma Schema
// SQLite database, all enums represented as String with app-level validation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE / SYSTEM
// ============================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("admin") // developer|owner|admin|manager|accountant|cashier|employee|viewer
  phone     String?
  avatar    String?
  branchId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch        Branch?         @relation(fields: [branchId], references: [id])
  auditLogs     AuditLog[]
  notifications Notification[]
  createdAt2    DateTime        @default(now()) @map("created_at_2")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  taxNumber String?
  isMain    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  storehouses       Storehouse[]
  salesOrders       SalesOrder[]
  purchaseOrders    PurchaseOrder[]
  salesInvoices     SalesInvoice[]
  purchaseInvoices  PurchaseInvoice[]
  partners          Partner[]
  activities        Activity[]
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  share     Float    @default(0) // percentage
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  name      String
  code      String?
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info|success|warning|error
  category  String   @default("system") // system|inventory|sales|purchases|finance|accounting
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // create|update|delete|login|logout
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

// ============================================================
// INVENTORY
// ============================================================

model Category {
  id       String  @id @default(cuid())
  name     String
  nameAr   String?
  parentId String?
  active   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  barcode     String?
  name        String
  nameAr      String?
  description String?
  categoryId  String?
  unit        String   @default("piece") // piece|kg|liter|box|pack|unit
  costPrice   Float    @default(0)
  salePrice   Float    @default(0)
  taxRate     Float    @default(15)
  minStock    Float    @default(0)
  type        String   @default("product") // product|service|raw_material|finished
  image       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category          Category?              @relation(fields: [categoryId], references: [id])
  stockItems        StockItem[]
  stockMovements    StockMovement[]
  salesOrderItems   SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  salesInvoiceItems SalesInvoiceItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  bomComponents     BomComponent[]
  boms              Bom[]
}

model Storehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  branchId  String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch?       @relation(fields: [branchId], references: [id])
  stockItems   StockItem[]
  movements    StockMovement[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
}

model StockItem {
  id            String    @id @default(cuid())
  productId     String
  storehouseId  String
  quantity      Float     @default(0)
  batch         String?
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  storehouse Storehouse  @relation(fields: [storehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, storehouseId, batch])
}

model StockMovement {
  id           String   @id @default(cuid())
  productId    String
  storehouseId String
  type         String   // in|out|transfer|adjustment
  quantity     Float
  refType      String?  // sales_order|purchase_order|transfer|stock_take|adjustment
  refId        String?
  userId       String?
  note         String?
  createdAt    DateTime @default(now())

  product    Product    @relation(fields: [productId], references: [id])
  storehouse Storehouse @relation(fields: [storehouseId], references: [id])
}

model StockTransfer {
  id               String   @id @default(cuid())
  code             String   @unique
  fromStorehouseId String
  toStorehouseId   String
  status           String   @default("draft") // draft|in_transit|received|cancelled
  itemsJson        String   // JSON array of {productId, quantity}
  userId           String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromStorehouse Storehouse @relation("TransferFrom", fields: [fromStorehouseId], references: [id])
  toStorehouse   Storehouse @relation("TransferTo", fields: [toStorehouseId], references: [id])
}

model StockTake {
  id           String   @id @default(cuid())
  code         String   @unique
  storehouseId String
  status       String   @default("draft") // draft|completed|cancelled
  note         String?
  itemsJson    String   // JSON array of {productId, systemQty, countedQty, diff}
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InventoryRequisition {
  id           String   @id @default(cuid())
  code         String   @unique
  storehouseId String
  status       String   @default("draft") // draft|approved|rejected|fulfilled
  itemsJson    String   // JSON array of {productId, quantity, note}
  requesterId  String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// SALES
// ============================================================

model Client {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  taxNumber    String?
  balance      Float    @default(0)
  creditLimit  Float    @default(0)
  openingBalance Float  @default(0)
  accountId    String?  // linked receivable account
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesOrders     SalesOrder[]
  salesInvoices   SalesInvoice[]
  salesPayments   SalesPayment[]
  salesCreditNotes SalesCreditNote[]
}

model SalesOrder {
  id            String   @id @default(cuid())
  code          String   @unique
  branchId      String?
  clientId      String
  userId        String?
  status        String   @default("draft") // draft|confirmed|delivered|paid|cancelled
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  discount      Float    @default(0)
  total         Float    @default(0)
  paid          Float    @default(0)
  paymentMethod String?  // cash|card|transfer|credit
  note          String?
  isPos         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch Branch?  @relation(fields: [branchId], references: [id])
  client Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  SalesOrderItem[]
}

model SalesOrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Float
  unitPrice  Float
  discount   Float   @default(0)
  taxRate    Float   @default(0)
  total      Float   @default(0)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])
}

model SalesInvoice {
  id           String   @id @default(cuid())
  code         String   @unique
  branchId     String?
  clientId     String
  orderId      String?
  userId       String?
  status       String   @default("draft") // draft|posted|paid|cancelled
  issueDate    DateTime @default(now())
  dueDate      DateTime?
  subtotal     Float    @default(0)
  taxTotal     Float    @default(0)
  discount     Float    @default(0)
  total        Float    @default(0)
  paid         Float    @default(0)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch    Branch?        @relation(fields: [branchId], references: [id])
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items     SalesInvoiceItem[]
}

model SalesInvoiceItem {
  id         String  @id @default(cuid())
  invoiceId  String
  productId  String
  quantity   Float
  unitPrice  Float
  discount   Float   @default(0)
  taxRate    Float   @default(0)
  total      Float   @default(0)

  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product  Product      @relation(fields: [productId], references: [id])
}

model SalesCreditNote {
  id         String   @id @default(cuid())
  code       String   @unique
  clientId   String
  invoiceId  String?
  userId     String?
  status     String   @default("draft") // draft|posted|cancelled
  issueDate  DateTime @default(now())
  subtotal   Float    @default(0)
  taxTotal   Float    @default(0)
  total      Float    @default(0)
  reason     String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SalesPayment {
  id           String   @id @default(cuid())
  code         String   @unique
  type         String   @default("receipt") // receipt (سند قبض)
  clientId     String
  invoiceId    String?
  userId       String?
  amount       Float
  date         DateTime @default(now())
  method       String   @default("cash") // cash|card|transfer|check
  reference    String?
  status       String   @default("completed") // pending|completed|cancelled|refunded
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ============================================================
// PURCHASES
// ============================================================

model Supplier {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  taxNumber    String?
  balance      Float    @default(0)
  openingBalance Float  @default(0)
  accountId    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  purchasePayments   PurchasePayment[]
  purchaseCreditNotes PurchaseCreditNote[]
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  code          String   @unique
  branchId      String?
  supplierId    String
  userId        String?
  status        String   @default("draft") // draft|ordered|received|paid|cancelled
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  discount      Float    @default(0)
  total         Float    @default(0)
  paid          Float    @default(0)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch   Branch?           @relation(fields: [branchId], references: [id])
  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Float
  unitPrice  Float
  discount   Float   @default(0)
  taxRate    Float   @default(0)
  total      Float   @default(0)

  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
}

model PurchaseInvoice {
  id           String   @id @default(cuid())
  code         String   @unique
  branchId     String?
  supplierId   String
  orderId      String?
  userId       String?
  status       String   @default("draft") // draft|posted|paid|cancelled
  issueDate    DateTime @default(now())
  dueDate      DateTime?
  subtotal     Float    @default(0)
  taxTotal     Float    @default(0)
  discount     Float    @default(0)
  total        Float    @default(0)
  paid         Float    @default(0)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch   Branch?             @relation(fields: [branchId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    PurchaseInvoiceItem[]
}

model PurchaseInvoiceItem {
  id         String  @id @default(cuid())
  invoiceId  String
  productId  String
  quantity   Float
  unitPrice  Float
  discount   Float   @default(0)
  taxRate    Float   @default(0)
  total      Float   @default(0)

  invoice  PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
}

model PurchaseCreditNote {
  id         String   @id @default(cuid())
  code       String   @unique
  supplierId String
  invoiceId  String?
  userId     String?
  status     String   @default("draft")
  issueDate  DateTime @default(now())
  subtotal   Float    @default(0)
  taxTotal   Float    @default(0)
  total      Float    @default(0)
  reason     String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model PurchasePayment {
  id           String   @id @default(cuid())
  code         String   @unique
  type         String   @default("payment") // payment (سند صرف)
  supplierId   String
  invoiceId    String?
  userId       String?
  amount       Float
  date         DateTime @default(now())
  method       String   @default("cash") // cash|card|transfer|check
  reference    String?
  status       String   @default("completed")
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

// ============================================================
// ACCOUNTING
// ============================================================

model Account {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  nameAr    String?
  type      String   // asset|liability|equity|income|expense
  subtype   String?  // current_asset|fixed_asset|current_liability|long_term_liability|...
  parentId  String?
  balance   Float    @default(0)
  active    Boolean  @default(true)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      Account?       @relation("AccountTree", fields: [parentId], references: [id])
  children    Account[]      @relation("AccountTree")
  journalLines JournalLine[]
}

model AnalyticAccount {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  parentId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   AnalyticAccount?  @relation("AnalyticTree", fields: [parentId], references: [id])
  children AnalyticAccount[] @relation("AnalyticTree")
}

model JournalEntry {
  id          String   @id @default(cuid())
  code        String   @unique
  date        DateTime @default(now())
  userId      String?
  description String?
  refType     String?  // sales_order|purchase_order|payment|production|manual
  refId       String?
  status      String   @default("posted") // draft|posted|reversed
  totalDebit  Float    @default(0)
  totalCredit Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines JournalLine[]
}

model JournalLine {
  id          String  @id @default(cuid())
  entryId     String
  accountId   String
  debit       Float   @default(0)
  credit      Float   @default(0)
  description String?

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])
}

model ClosedPeriod {
  id         String    @id @default(cuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  status     String    @default("open") // open|closed|locked
  closedBy   String?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ============================================================
// FINANCE
// ============================================================

model BankAccount {
  id         String   @id @default(cuid())
  name       String
  bankName   String
  iban       String?
  accountNo  String?
  currency   String   @default("SAR")
  balance    Float    @default(0)
  accountId  String?  // linked ledger account
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Safe {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique
  branchId   String?
  balance    Float    @default(0)
  currency   String   @default("SAR")
  accountId  String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FinanceTransaction {
  id           String   @id @default(cuid())
  code         String   @unique
  type         String   // expense|revenue|transfer
  amount       Float
  date         DateTime @default(now())
  fromAccountId String? // for transfer
  toAccountId   String? // for transfer
  bankAccountId String?
  safeId       String?
  categoryId   String?  // expense/revenue category
  payee        String?
  reference    String?
  note         String?
  userId       String?
  status       String   @default("completed")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FinanceRequisition {
  id           String   @id @default(cuid())
  code         String   @unique
  amount       Float
  payee        String?
  type         String   @default("expense") // expense|transfer
  status       String   @default("draft") // draft|approved|rejected|fulfilled
  requesterId  String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================================
// PRODUCTION (BOM)
// ============================================================

model Bom {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  productId  String
  outputQty  Float    @default(1)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product         @relation(fields: [productId], references: [id])
  components BomComponent[]
}

model BomComponent {
  id        String @id @default(cuid())
  bomId     String
  productId String
  quantity  Float

  bom     Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
