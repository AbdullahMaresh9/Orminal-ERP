// =============================================================================
// Enterprise ERP — Prisma Schema
// Source of Truth: Volume 4 SDTA Books 1-5 + Volume 2 Blueprint + Volume 3 FTS
// + Arabic Accounting Spec + Benchmark Gap-Completion
//
// Architectural Mandates (from ADRs):
// - ADR-001 Unified Business Partner (partners table + role profiles)
// - ADR-002 Ledger-Centric Posting (central posting service, immutable posted)
// - ADR-007 Append-only Inventory Ledger (stock_moves never edited)
// - ADR-009 RBAC + ABAC + Data Scopes
// - ADR-014 Append-only Audit
// - ADR-016 Legal Number Sequences (non-reusable, gap-reported)
// - ADR-018 Draft → Post → Reverse (no edit of posted docs)
//
// Multi-tenant: company_id + branch_id scoping on all transactional tables.
// SQLite limitation: enums as String, JSON fields as String (JSON.stringify).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_UNPOOLED")
}

// ============================================================================
// PLATFORM / IDENTITY / SECURITY (Book 1 §1.9 Shared Kernel, ADR-009)
// =============================================================================

model Company {
  id                   String    @id @default(cuid())
  code                 String    @unique
  nameAr               String
  nameEn               String
  shortName            String?
  legalName            String?
  companyType          String?   @default("LLC")
  taxNumber            String?
  crNumber             String?   // Commercial Registration
  vatNumber            String?
  nationalId           String?
  establishedAt        DateTime?
  address              String?
  phone                String?
  mobile               String?
  fax                  String?
  email                String?
  website              String?
  country              String?   @default("SA")
  city                 String?
  district             String?
  postalCode           String?
  logoUrl              String?
  logoPrintUrl         String?
  faviconUrl           String?
  currencyId           String    // base currency
  decimalPrecision     Int       @default(2)
  taxPolicy            String?   @default("STANDARD")
  timezone             String    @default("Asia/Riyadh")
  locale               String    @default("ar")
  dateFormat           String?   @default("YYYY-MM-DD")
  weekStartDay         String?   @default("SATURDAY")
  numberFormat         String?   @default("STANDARD")
  fiscalYearStartMonth Int       @default(1)
  mainBranchId         String?
  active               Boolean   @default(true)
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  currency      Currency       @relation(fields: [currencyId], references: [id])
  branches      Branch[]
  users         User[]
  partners      Partner[]
  products      Product[]
  fiscalYears   FiscalYear[]
  orgStructures OrgStructure[]
  // transactions scoped by company
  expenses      Expense[]
  revenues      Revenue[]

  @@index([currencyId])
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  companyId String
  address   String?
  phone     String?
  email     String?
  managerId String?
  isMain    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager       User?          @relation("BranchManager", fields: [managerId], references: [id])
  warehouses    Warehouse[]
  users         User[]         @relation("BranchUsers")
  defaultUsers  User[]         @relation("UserDefaultBranch")
  orgStructures OrgStructure[]
  // transactions scoped by branch
  activities    Activity[]
  expenses      Expense[]
  revenues      Revenue[]

  @@index([companyId])
  @@index([managerId])
}

model OrgStructure {
  id                String    @id @default(cuid())
  code              String    @unique
  nameAr            String
  nameEn            String?
  parentId          String?
  type              String    @default("إدارة") // قطاع | إدارة عامة | إدارة | قسم | وحدة
  level             Int       @default(1)
  path              String?   // materialized path e.g. '/rootId/parentId/thisId'
  sortOrder         Int       @default(0)
  companyId         String?
  branchId          String?
  costCenterId      String?
  managerId         String?
  status            String    @default("active") // draft | active | suspended | archived
  active            Boolean   @default(true)
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  notes             String?

  // Enterprise Audit & LifeCycle metadata
  suspendedBy       String?
  suspendedAt       DateTime?
  suspensionReason  String?
  suspensionCount   Int       @default(0)
  modificationCount Int       @default(0)
  printCount        Int       @default(0)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  parent     OrgStructure?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   OrgStructure[] @relation("OrgHierarchy")
  company    Company?       @relation(fields: [companyId], references: [id])
  branch     Branch?        @relation(fields: [branchId], references: [id])
  costCenter CostCenter?    @relation(fields: [costCenterId], references: [id])
  manager    Employee?      @relation("OrgUnitManager", fields: [managerId], references: [id])
  employees  Employee[]     @relation("OrgUnitEmployees")

  @@index([parentId])
  @@index([code])
  @@index([companyId])
  @@index([branchId])
  @@index([costCenterId])
  @@index([managerId])
  @@index([status])
  @@index([path])
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  email            String    @unique
  nameAr           String
  nameEn           String?
  passwordHash     String
  phone            String?
  avatar           String?
  defaultCompanyId String?
  defaultBranchId  String?
  locale           String    @default("ar")
  timezone         String    @default("Asia/Riyadh")
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  active           Boolean   @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  defaultCompany          Company?          @relation(fields: [defaultCompanyId], references: [id])
  defaultBranch           Branch?           @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  employee                Employee?
  managedBranches         Branch[]          @relation("BranchManager")
  branches                Branch[]          @relation("BranchUsers")
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  outboxEvents            OutboxEvent[]
  approvals               ApprovalStep[]
  // document ownership
  createdSalesOrders      SalesOrder[]      @relation("SalesOrderCreator")
  createdPurchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderCreator")
  createdJournalEntries   JournalEntry[]    @relation("JournalEntryCreator")
  createdProductionOrders ProductionOrder[] @relation("ProductionOrderCreator")

  @@index([defaultCompanyId])
  @@index([defaultBranchId])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id            String   @id @default(cuid())
  moduleCode    String // e.g. 'FIN', 'SAL', 'PUR', 'INV', 'MFG', 'HR'
  menuCode      String? // menu item code
  actionCode    String // e.g. 'JE_CREATE', 'SO_CONFIRM'
  nameAr        String
  nameEn        String
  riskLevel     String   @default("low") // low|medium|high|critical
  requiresAudit Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id             String   @id @default(cuid())
  roleId         String
  permissionId   String
  canCreate      Boolean  @default(false)
  canRead        Boolean  @default(true)
  canUpdate      Boolean  @default(false)
  canDelete      Boolean  @default(false)
  canApprove     Boolean  @default(false)
  canPost        Boolean  @default(false)
  canCancel      Boolean  @default(false)
  canReverse     Boolean  @default(false)
  canPrint       Boolean  @default(true)
  canExport      Boolean  @default(false)
  canImport      Boolean  @default(false)
  dataScope      String   @default("own") // own|team|branch|company|all
  companyScope   String? // JSON array of company IDs, null = all
  branchScope    String? // JSON array of branch IDs, null = all
  warehouseScope String? // JSON array
  createdAt      DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  companyId String?
  branchId  String?
  validFrom DateTime  @default(now())
  validTo   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([companyId])
  @@index([branchId])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  companyId     String?
  moduleCode    String
  documentType  String
  documentId    String?
  action        String // create|update|delete|post|reverse|cancel|approve|login|logout|export
  oldValue      String? // JSON
  newValue      String? // JSON
  reason        String?
  ipAddress     String?
  deviceInfo    String?
  correlationId String?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([moduleCode, documentType, documentId])
  @@index([userId])
  @@index([createdAt])
  @@index([companyId])
  @@index([documentId])
  @@index([correlationId])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  eventType     String // e.g. 'SalesOrderConfirmed', 'InvoicePosted'
  aggregateType String // 'sales_order', 'journal_entry', etc.
  aggregateId   String
  payload       String // JSON
  metadata      String? // JSON (correlationId, userId, etc.)
  status        String    @default("pending") // pending|dispatched|failed
  retryCount    Int       @default(0)
  dispatchedAt  DateTime?
  userId        String?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([aggregateId])
  @@index([userId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  title         String
  message       String
  type          String   @default("info") // info|success|warning|error
  category      String   @default("system") // system|finance|sales|purchase|inventory|hr|workflow
  isRead        Boolean  @default(false)
  link          String? // module key or URL
  correlationId String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([correlationId])
}

model ApprovalStep {
  id           String    @id @default(cuid())
  documentType String
  documentId   String
  stepOrder    Int
  approverRole String
  approverId   String?
  status       String    @default("pending") // pending|approved|rejected|delegated
  comment      String?
  actedAt      DateTime?
  createdAt    DateTime  @default(now())

  approver User? @relation(fields: [approverId], references: [id])

  @@index([documentType, documentId])
  @@index([approverId, status])
  @@index([documentId])
  @@index([status])
}

model NumberSequence {
  id           String  @id @default(cuid())
  companyId    String
  branchId     String?
  documentType String // SO, INV, PO, JE, etc.
  prefix       String // SO, INV, PO, JE
  fiscalYear   Int?
  nextNumber   Int     @default(1)
  padding      Int     @default(6)
  resetPolicy  String  @default("yearly") // yearly|monthly|never
  lastNumber   Int     @default(0)

  @@unique([companyId, branchId, documentType, fiscalYear])
  @@index([branchId])
}

model Setting {
  id           String   @id @default(cuid())
  key          String
  // Scope: '*' means "all" at that level (NULL would break the unique
  // constraint — Postgres treats NULLs as distinct; same rationale as
  // AccountRoleMapping / ADR-CoA-001).
  // Resolution at read time: (companyId, branchId) → (companyId, '*') → ('*','*') → registry default.
  companyId    String   @default("*")
  branchId     String   @default("*")
  value        String
  category     String   @default("general") // general|company|accounting|inventory|sales|purchases|taxes|numbering|printing|notifications|zatca|email|import_export|backup|security|appearance|system
  label        String? // display label (Arabic)
  labelEn      String? // display label (English)
  type         String   @default("string") // string|number|boolean|select|color
  defaultValue String?
  options      String? // JSON array for select type
  description  String?
  isSystem     Boolean  @default(false) // system settings cannot be deleted
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([key, companyId, branchId])
  @@index([category])
  @@index([companyId, branchId])
}

model SettingAuditLog {
  id         String   @id @default(cuid())
  settingKey String
  oldValue   String?
  newValue   String?
  userId     String?
  companyId  String?
  branchId   String?
  category   String
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([settingKey])
  @@index([category])
  @@index([createdAt])
  @@index([userId])
}

// =============================================================================
// GENERAL DEFINITIONS / REFERENCE DATA (Single Source of Truth for Generic Lookups)
// =============================================================================

model GeneralDefinition {
  id          String   @id @default(cuid())
  companyId   String   @default("*")
  typeCode    String   // e.g. EMPLOYEE_GRADE, EMPLOYMENT_TYPE, QUALIFICATION, TERMINATION_REASON, HEALTH_INSURANCE_CATEGORY, HEALTH_INSURANCE_TIER, SPECIALIZATION, EMPLOYEE_CATEGORY, EMPLOYEE_RANK, EMPLOYEE_CLASSIFICATION, EMPLOYEE_GROUP, RESUME_TYPE, ORG_STRUCTURE_TYPE, CONTRACT_TYPE
  code        String   // Unique code within (companyId, typeCode)
  nameAr      String
  nameEn      String?
  description String?
  sortOrder   Int      @default(0)
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  meta        String?  // JSON metadata string
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, typeCode, code])
  @@index([companyId, typeCode, active])
  @@index([typeCode])
  @@index([code])
}

// =============================================================================
// REFERENCE DATA (Book 3 §3.8 — currencies, UOMs, countries, taxes, etc.)
// =============================================================================

model Currency {
  id                String   @id @default(cuid())
  code              String   @unique // SAR, USD, EUR, YER
  nameAr            String
  nameEn            String?
  symbol            String
  fractionNameAr    String?
  fractionNameEn    String?
  decimals          Int      @default(2)
  exchangeRate      Float    @default(1.0)
  buyRate           Float?
  sellRate          Float?
  minLimit          Float?
  maxLimit          Float?
  sortOrder         Int      @default(0)
  isBase            Boolean  @default(false)
  isInventory       Boolean  @default(false)
  status            String   @default("active") // active | suspended | archived
  active            Boolean  @default(true)
  suspensionCount   Int      @default(0)
  suspendedBy       String?
  suspendedAt       DateTime?
  notes             String?
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  companies         Company[]
  exchangeRates     ExchangeRate[]
  baseCurrencyRates ExchangeRate[] @relation("BaseCurrency")
  denominations     CurrencyDenomination[]
  accounts          Account[]
  bankAccounts      BankAccount[]
  safes             Safe[]

  @@index([code])
  @@index([status])
}

model CurrencyDenomination {
  id          String   @id @default(cuid())
  currencyId  String
  code        String
  nameAr      String
  nameEn      String?
  value       Float
  sortOrder   Int      @default(0)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@index([currencyId])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  currencyId     String
  baseCurrencyId String
  rate           Float
  buyRate        Float?
  sellRate       Float?
  minLimit       Float?
  maxLimit       Float?
  rateDate       DateTime @default(now())
  effectiveDate  DateTime @default(now())
  rateType       String   @default("spot") // spot|average|period_end
  status         String   @default("active")
  notes          String?
  userId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  currency     Currency @relation(fields: [currencyId], references: [id])
  baseCurrency Currency @relation("BaseCurrency", fields: [baseCurrencyId], references: [id])

  @@unique([currencyId, baseCurrencyId, rateDate, rateType])
  @@index([baseCurrencyId])
  @@index([currencyId])
}

model UnitOfMeasure {
  id       String  @id @default(cuid())
  code     String  @unique // PCE, KG, LTR, BOX
  nameAr   String
  nameEn   String
  category String  @default("unit") // unit|weight|volume|length|time
  active   Boolean @default(true)

  products Product[]
}

model Country {
  id       String  @id @default(cuid())
  code     String  @unique // SA, AE, EG
  nameAr   String
  nameEn   String
  dialCode String?

  partners Partner[]
}

model TaxCode {
  id            String   @id @default(cuid())
  code          String   @unique // VAT15, VAT0, EXEMPT
  nameAr        String
  nameEn        String
  rate          Float    @default(15)
  taxType       String   @default("vat") // vat|sales_tax|withholding
  inputAccount  String? // account code for input VAT
  outputAccount String? // account code for output VAT
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  products     Product[]
  journalLines JournalLine[]
  accounts     Account[]
}

model PaymentTerm {
  id                   String  @id @default(cuid())
  code                 String  @unique
  nameAr               String
  nameEn               String
  dueDays              Int     @default(30)
  earlyPaymentDiscount Float   @default(0)
  active               Boolean @default(true)

  partners Partner[]
}

model ReasonCode {
  id       String  @id @default(cuid())
  code     String  @unique
  nameAr   String
  nameEn   String
  category String // cancel|reject|reverse|scrap|adjustment
  active   Boolean @default(true)

  inventoryAdjustments InventoryAdjustment[]
}

// =============================================================================
// MASTER DATA — Business Partner (ADR-001 Unified BP)
// =============================================================================

model Partner {
  id                  String   @id @default(cuid())
  code                String   @unique
  nameAr              String
  nameEn              String?
  companyId           String
  isCustomer          Boolean  @default(false)
  isSupplier          Boolean  @default(false)
  isEmployee          Boolean  @default(false)
  taxNumber           String?
  vatNumber           String?
  crNumber            String?
  contactName         String?
  phone               String?
  email               String?
  website             String?
  address             String?
  city                String?
  countryId           String?
  paymentTermId       String?
  // customer fields
  creditLimit         Float    @default(0)
  openingBalance      Float    @default(0)
  currentBalance      Float    @default(0)
  // supplier fields
  supplierApproved    Boolean  @default(false)
  // linked ledger account (AR or AP)
  receivableAccountId String?
  payableAccountId    String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  country             Country?             @relation(fields: [countryId], references: [id])
  paymentTerm         PaymentTerm?         @relation(fields: [paymentTermId], references: [id])
  receivableAccount   Account?             @relation("PartnerAR", fields: [receivableAccountId], references: [id])
  payableAccount      Account?             @relation("PartnerAP", fields: [payableAccountId], references: [id])
  contacts            PartnerContact[]
  addresses           PartnerAddress[]
  bankAccounts        PartnerBankAccount[]
  // transactions
  salesQuotations     SalesQuotation[]
  salesOrders         SalesOrder[]
  salesInvoices       SalesInvoice[]
  salesPayments       SalesPayment[]
  salesCreditNotes    SalesCreditNote[]
  salesReturns        SalesReturn[]
  purchaseOrders      PurchaseOrder[]
  purchaseInvoices    PurchaseInvoice[]
  purchasePayments    PurchasePayment[]
  purchaseCreditNotes PurchaseCreditNote[]
  purchaseReturns     PurchaseReturn[]
  goodsReceipts       GoodsReceipt[]
  deliveries          Delivery[]
  journalLines        JournalLine[]

  @@index([companyId])
  @@index([countryId])
  @@index([paymentTermId])
  @@index([receivableAccountId])
  @@index([payableAccountId])
}

model PartnerContact {
  id        String  @id @default(cuid())
  partnerId String
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PartnerAddress {
  id        String  @id @default(cuid())
  partnerId String
  type      String  @default("billing") // billing|shipping|other
  address   String
  city      String?
  country   String?
  isDefault Boolean @default(false)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

model PartnerBankAccount {
  id          String  @id @default(cuid())
  partnerId   String
  bankName    String
  accountName String
  iban        String?
  accountNo   String?
  swiftCode   String?
  isDefault   Boolean @default(false)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
}

// =============================================================================
// MASTER DATA — Products, Categories, Warehouses (ADR-006 hierarchy)
// =============================================================================

model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String?
  parentId  String?
  type      String   @default("product") // product|partner|expense|revenue
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id                 String   @id @default(cuid())
  sku                String   @unique
  barcode            String?
  nameAr             String
  nameEn             String?
  description        String?
  companyId          String
  categoryId         String?
  uomId              String?
  type               String   @default("product") // product|service|raw_material|finished|consumable
  tracking           String   @default("none") // none|lot|serial
  costPrice          Float    @default(0)
  salePrice          Float    @default(0)
  costingMethod      String   @default("fifo") // fifo|avco|standard|specific
  taxCodeId          String?
  minStock           Float    @default(0)
  maxStock           Float    @default(0)
  reorderPoint       Float    @default(0)
  valuationAccountId String? // inventory account
  cogsAccountId      String?
  revenueAccountId   String?
  image              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category                 Category?                 @relation(fields: [categoryId], references: [id])
  uom                      UnitOfMeasure?            @relation(fields: [uomId], references: [id])
  taxCode                  TaxCode?                  @relation(fields: [taxCodeId], references: [id])
  valuationAccount         Account?                  @relation("ProductValuation", fields: [valuationAccountId], references: [id])
  cogsAccount              Account?                  @relation("ProductCOGS", fields: [cogsAccountId], references: [id])
  revenueAccount           Account?                  @relation("ProductRevenue", fields: [revenueAccountId], references: [id])
  // inventory
  stockQuants              StockQuant[]
  stockMoves               StockMove[]
  stockValuationLayers     StockValuationLayer[]
  stockLots                StockLot[]
  // transaction lines
  salesOrderLines          SalesOrderLine[]
  salesInvoiceLines        SalesInvoiceLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]
  bomComponents            BomComponent[]
  boms                     Bom[]
  productionOrders         ProductionOrder[]
  deliveryLines            DeliveryLine[]
  goodsReceiptLines        GoodsReceiptLine[]
  stockTransferLines       StockTransferLine[]
  inventoryAdjustmentLines InventoryAdjustmentLine[]
  salesQuotationLines      SalesQuotationLine[]
  purchaseRequestLines     PurchaseRequestLine[]
  salesReturnLines         SalesReturnLine[]
  purchaseReturnLines      PurchaseReturnLine[]
  stockReservations        StockReservation[]
  salesCreditNoteLines     SalesCreditNoteLine[]
  purchaseCreditNoteLines  PurchaseCreditNoteLine[]

  @@index([companyId])
  @@index([categoryId])
  @@index([uomId])
  @@index([taxCodeId])
  @@index([valuationAccountId])
  @@index([cogsAccountId])
  @@index([revenueAccountId])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  nameAr    String
  nameEn    String?
  branchId  String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch               Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locations            StockLocation[]
  stockQuants          StockQuant[]
  stockMovesSource     StockMove[]           @relation("MoveSource")
  stockMovesDest       StockMove[]           @relation("MoveDest")
  // receipts/deliveries/transfers
  goodsReceipts        GoodsReceipt[]
  deliveries           Delivery[]
  stockTransfersFrom   StockTransfer[]       @relation("TransferFromWH")
  stockTransfersTo     StockTransfer[]       @relation("TransferToWH")
  inventoryAdjustments InventoryAdjustment[]
  stockReservations    StockReservation[]

  @@index([branchId])
}

model StockLocation {
  id          String   @id @default(cuid())
  code        String
  nameAr      String
  nameEn      String?
  warehouseId String
  parentId    String?
  type        String   @default("internal") // internal|supplier|customer|transit|loss|production
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent      StockLocation?  @relation("LocationTree", fields: [parentId], references: [id])
  children    StockLocation[] @relation("LocationTree")
  sourceMoves StockMove[]     @relation("MoveSourceLoc")
  destMoves   StockMove[]     @relation("MoveDestLoc")
  stockQuants StockQuant[]

  @@index([warehouseId])
  @@index([parentId])
}

model StockQuant {
  // Current stock balance per product/location/lot (derived from append-only ledger)
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  locationId  String?
  lotId       String?
  quantity    Float    @default(0)
  reservedQty Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  StockLocation? @relation(fields: [locationId], references: [id])
  lot       StockLot?      @relation(fields: [lotId], references: [id])

  @@unique([productId, warehouseId, locationId, lotId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([lotId])
}

model StockLot {
  id              String    @id @default(cuid())
  lotNumber       String
  productId       String
  expiryDate      DateTime?
  manufactureDate DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  product     Product      @relation(fields: [productId], references: [id])
  stockQuants StockQuant[]
  stockMoves  StockMove[]

  @@index([productId])
}

model StockMove {
  // APPEND-ONLY inventory ledger (ADR-007). Never edited after 'done'.
  id                String   @id @default(cuid())
  companyId         String
  documentType      String // delivery|receipt|transfer|adjustment|production
  documentId        String?
  documentLineId    String?
  productId         String
  sourceWarehouseId String?
  sourceLocationId  String?
  destWarehouseId   String?
  destLocationId    String?
  lotId             String?
  quantity          Float
  uomId             String?
  state             String   @default("draft") // draft|waiting|ready|done|cancelled
  valuationAmount   Float?
  costPrice         Float?
  postingDate       DateTime @default(now())
  createdAt         DateTime @default(now())

  product         Product               @relation(fields: [productId], references: [id])
  sourceWarehouse Warehouse?            @relation("MoveSource", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse?            @relation("MoveDest", fields: [destWarehouseId], references: [id])
  sourceLocation  StockLocation?        @relation("MoveSourceLoc", fields: [sourceLocationId], references: [id])
  destLocation    StockLocation?        @relation("MoveDestLoc", fields: [destLocationId], references: [id])
  lot             StockLot?             @relation(fields: [lotId], references: [id])
  valuationLayers StockValuationLayer[]

  @@index([productId, destWarehouseId])
  @@index([documentType, documentId])
  @@index([state, postingDate])
  @@index([companyId])
  @@index([documentId])
  @@index([documentLineId])
  @@index([sourceWarehouseId])
  @@index([sourceLocationId])
  @@index([destWarehouseId])
  @@index([destLocationId])
  @@index([lotId])
  @@index([uomId])
}

model StockValuationLayer {
  id           String   @id @default(cuid())
  productId    String
  stockMoveId  String?
  quantity     Float
  unitCost     Float
  totalValue   Float
  remainingQty Float
  createdAt    DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMove StockMove? @relation(fields: [stockMoveId], references: [id])

  @@index([productId])
  @@index([stockMoveId])
}

model StockReservation {
  id           String    @id @default(cuid())
  productId    String
  warehouseId  String
  documentType String
  documentId   String
  quantity     Float
  state        String    @default("active") // active|released|consumed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([documentId])
  @@index([state])
}

// =============================================================================
// FINANCE — Chart of Accounts, Journals, Fiscal Periods, Dimensions
// =============================================================================

model Account {
  // ENTERPRISE CHART OF ACCOUNTS (re-engineered).
  // Hierarchy: Account Class -> Account Group -> Parent Account -> Posting Account.
  // Only isPosting=true accounts may receive JournalLines (enforced in accounting engine + API).
  // Group accounts (isPosting=false) aggregate child balances; they are never posted to.
  id                  String    @id @default(cuid())
  code                String    @unique
  nameAr              String
  nameEn              String?
  shortName           String?
  // accountClass is the reporting/structural class (8 classes, extensible).
  // asset|liability|equity|revenue|cogs|operating_expense|other_income|other_expense
  accountClass        String    @default("asset")
  // type is the ledger primitive kept for backward compatibility with existing
  // postings/reports: asset|liability|equity|income|expense. Derived from accountClass.
  type                String
  subtype             String?
  parentId            String?
  isPosting           Boolean   @default(true) // false = group account (aggregates only)
  isSystem            Boolean   @default(false)
  // normalBalance drives balance sign + statement presentation: debit|credit
  normalBalance       String    @default("debit")
  currencyId          String?
  allowReconciliation Boolean   @default(false)
  allowManualEntry    Boolean   @default(true)
  // Tax behaviour: none|input|output|withholding
  taxBehavior         String    @default("none")
  taxCodeId           String?
  // Financial statement mapping: balance_sheet|income_statement|cash_flow|none
  fsSection           String    @default("none")
  reportCategory      String?
  reportSubcategory   String?
  reportTags          String? // JSON array of tag strings
  // Dimension rules — enforce dimensional accounting instead of per-dimension accounts
  requireCostCenter   Boolean   @default(false)
  requireBranch       Boolean   @default(false)
  requireProject      Boolean   @default(false)
  // Materialized hierarchy helpers (maintained by account-service)
  level               Int       @default(0)
  path                String? // '/rootId/childId/thisId' — used for subtree queries + cycle detection
  balance             Float     @default(0) // cached; authoritative balance is derived from JournalLine
  active              Boolean   @default(true)
  deactivatedAt       DateTime?
  deactivatedBy       String?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  parent             Account?             @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]            @relation("AccountTree")
  currency           Currency?            @relation(fields: [currencyId], references: [id])
  taxCode            TaxCode?             @relation(fields: [taxCodeId], references: [id])
  roleMappings       AccountRoleMapping[]
  journalLines       JournalLine[]
  // linked entities
  partnerReceivables Partner[]            @relation("PartnerAR")
  partnerPayables    Partner[]            @relation("PartnerAP")
  productValuation   Product[]            @relation("ProductValuation")
  productCOGS        Product[]            @relation("ProductCOGS")
  productRevenue     Product[]            @relation("ProductRevenue")
  banks              BankAccount[]
  safes              Safe[]

  @@index([parentId])
  @@index([accountClass])
  @@index([type])
  @@index([isPosting, active])
  @@index([path])
  @@index([currencyId])
  @@index([taxCodeId])
}

// === Account Determination (ADR-CoA-001) ===
// Single source of truth mapping a semantic business role -> GL account.
// Business modules NEVER hardcode account codes; they resolve through this table.
// Scope resolution order: (company, branch) -> (company, '*') -> ('*', '*').
// companyId/branchId use the '*' sentinel instead of NULL so the unique index
// actually prevents duplicate role assignments (Postgres treats NULLs as distinct).
model AccountRoleMapping {
  id        String   @id @default(cuid())
  companyId String   @default("*")
  branchId  String   @default("*")
  role      String // CUSTOMER_RECEIVABLE|SUPPLIER_PAYABLE|SALES|COGS|INVENTORY|...
  accountId String
  active    Boolean  @default(true)
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([companyId, branchId, role])
  @@index([role])
  @@index([accountId])
  @@index([branchId])
}

model Journal {
  id                   String   @id @default(cuid())
  code                 String   @unique
  nameAr               String
  nameEn               String?
  type                 String   @default("general") // sale|purchase|cash|bank|general|opening|closing
  defaultDebitAccount  String?
  defaultCreditAccount String?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())

  journalEntries JournalEntry[]
}

model FiscalYear {
  id        String    @id @default(cuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  state     String    @default("open") // open|adjusting|locked|closed
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime  @default(now())

  company Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  periods FiscalPeriod[]

  @@index([companyId])
  @@index([state])
}

model FiscalPeriod {
  id           String    @id @default(cuid())
  fiscalYearId String
  name         String
  startDate    DateTime
  endDate      DateTime
  quarter      Int?
  state        String    @default("open") // open|adjusting|locked|closed
  closedAt     DateTime?
  closedBy     String?
  createdAt    DateTime  @default(now())

  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([fiscalYearId])
  @@index([state])
}

model CostCenter {
  id       String  @id @default(cuid())
  code     String  @unique
  nameAr   String
  nameEn   String?
  parentId String?
  active   Boolean @default(true)

  parent   CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children CostCenter[] @relation("CostCenterTree")

  journalLines         JournalLine[]
  purchaseRequestLines PurchaseRequestLine[]
  orgStructures        OrgStructure[]

  @@index([parentId])
}

model AnalyticAccount {
  id       String  @id @default(cuid())
  code     String  @unique
  nameAr   String
  nameEn   String?
  parentId String?
  active   Boolean @default(true)

  parent   AnalyticAccount?  @relation("AnalyticTree", fields: [parentId], references: [id])
  children AnalyticAccount[] @relation("AnalyticTree")

  journalLines JournalLine[]

  @@index([parentId])
}

model JournalEntry {
  // IMMUTABLE once posted (ADR-002, ADR-018). Draft can be edited; posted → reverse only.
  id             String   @id @default(cuid())
  companyId      String
  branchId       String?
  code           String   @unique // JE-YYYY-000001
  journalId      String?
  postingDate    DateTime @default(now())
  reference      String?
  description    String?
  refType        String? // sales_order|purchase_order|payment|production|manual|opening|closing
  refId          String?
  currencyId     String?
  state          String   @default("draft") // draft|submitted|approved|posted|reversed|cancelled
  totalDebit     Float    @default(0)
  totalCredit    Float    @default(0)
  fiscalPeriodId String?
  createdBy      String?
  approvedBy     String?
  postedBy       String?
  reversedById   String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journal        Journal?      @relation(fields: [journalId], references: [id])
  creator        User?         @relation("JournalEntryCreator", fields: [createdBy], references: [id])
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])
  reversingEntry JournalEntry? @relation("JournalReversal", fields: [reversedById], references: [id])
  reversedEntry  JournalEntry? @relation("JournalReversal")
  lines          JournalLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([journalId])
  @@index([refId])
  @@index([currencyId])
  @@index([state])
  @@index([fiscalPeriodId])
  @@index([reversedById])
}

model JournalLine {
  id                String  @id @default(cuid())
  entryId           String
  accountId         String
  partnerId         String?
  debit             Float   @default(0)
  credit            Float   @default(0)
  description       String?
  costCenterId      String?
  analyticAccountId String?
  taxCodeId         String?

  entry           JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id])
  partner         Partner?         @relation(fields: [partnerId], references: [id])
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id])
  analyticAccount AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])
  taxCode         TaxCode?         @relation(fields: [taxCodeId], references: [id])

  @@index([accountId])
  @@index([entryId])
  @@index([partnerId])
  @@index([costCenterId])
  @@index([analyticAccountId])
  @@index([taxCodeId])
}

// =============================================================================
// FINANCE — Bank, Cash/Safe, Payments
