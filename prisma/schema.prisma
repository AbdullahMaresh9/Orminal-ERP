  companyId    String
  branchId     String?
  code         String    @unique // PR-YYYY-000001
  requesterId  String?
  department   String?
  requiredDate DateTime?
  status       String    @default("draft") // draft|submitted|approved|rejected|converted
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines PurchaseRequestLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([requesterId])
  @@index([status])
}

model PurchaseRequestLine {
  id           String    @id @default(cuid())
  requestId    String
  productId    String
  quantity     Float
  uomId        String?
  requiredDate DateTime?
  costCenterId String?
  notes        String?

  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  costCenter CostCenter?     @relation(fields: [costCenterId], references: [id])

  @@index([requestId])
  @@index([productId])
  @@index([uomId])
  @@index([costCenterId])
}

model PurchaseOrder {
  id            String    @id @default(cuid())
  companyId     String
  branchId      String?
  code          String    @unique // PO-YYYY-000001
  partnerId     String
  orderDate     DateTime  @default(now())
  expectedDate  DateTime?
  currencyId    String?
  paymentTermId String?
  warehouseId   String?
  incoterms     String?
  receiptStatus String    @default("pending") // pending|partial|received
  invoiceStatus String    @default("pending") // pending|partial|invoiced
  paymentStatus String    @default("unpaid") // unpaid|partial|paid
  budgetStatus  String    @default("ok") // ok|warning|blocked
  status        String    @default("draft") // draft|submitted|approved|sent|confirmed|partially_received|received|billed|paid|closed|cancelled
  subtotal      Float     @default(0)
  taxTotal      Float     @default(0)
  discount      Float     @default(0)
  total         Float     @default(0)
  paid          Float     @default(0)
  notes         String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  partner       Partner             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  creator       User?               @relation("PurchaseOrderCreator", fields: [createdBy], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([currencyId])
  @@index([paymentTermId])
  @@index([warehouseId])
  @@index([status])
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  description     String?
  quantity        Float
  receivedQty     Float   @default(0)
  invoicedQty     Float   @default(0)
  uomId           String?
  unitCost        Float
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  taxCodeId       String?
  taxRate         Float   @default(0)
  total           Float   @default(0)

  order   PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([uomId])
  @@index([taxCodeId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  companyId       String
  branchId        String?
  code            String   @unique // GRN-YYYY-000001
  purchaseOrderId String?
  partnerId       String
  warehouseId     String
  receiptDate     DateTime @default(now())
  status          String   @default("draft") // draft|received|validated|cancelled
  notes           String?
  journalEntryId  String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  partner       Partner            @relation(fields: [partnerId], references: [id])
  lines         GoodsReceiptLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([purchaseOrderId])
  @@index([partnerId])
  @@index([warehouseId])
  @@index([status])
  @@index([journalEntryId])
}

model GoodsReceiptLine {
  id                  String    @id @default(cuid())
  receiptId           String
  productId           String
  purchaseOrderLineId String?
  orderedQty          Float
  receivedQty         Float
  uomId               String?
  lotNumber           String?
  expiryDate          DateTime?
  unitCost            Float
  total               Float

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([receiptId])
  @@index([productId])
  @@index([purchaseOrderLineId])
  @@index([uomId])
}

model PurchaseInvoice {
  // Vendor Bill
  id              String    @id @default(cuid())
  companyId       String
  branchId        String?
  code            String    @unique // VB-YYYY-000001
  partnerId       String
  purchaseOrderId String?
  billDate        DateTime  @default(now())
  accountingDate  DateTime  @default(now())
  dueDate         DateTime?
  vendorBillNo    String?
  journalId       String?
  currencyId      String?
  paymentTermId   String?
  status          String    @default("draft") // draft|pending_match|matched|posted|partially_paid|paid|reversed|cancelled
  subtotal        Float     @default(0)
  taxTotal        Float     @default(0)
  total           Float     @default(0)
  paid            Float     @default(0)
  journalEntryId  String?
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  partner Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines   PurchaseInvoiceLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([purchaseOrderId])
  @@index([journalId])
  @@index([currencyId])
  @@index([paymentTermId])
  @@index([status])
  @@index([journalEntryId])
}

model PurchaseInvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  productId       String
  description     String?
  quantity        Float
  uomId           String?
  unitCost        Float
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  taxCodeId       String?
  taxRate         Float   @default(0)
  total           Float   @default(0)

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([uomId])
  @@index([taxCodeId])
}

model PurchaseCreditNote {
  id             String   @id @default(cuid())
  companyId      String
  branchId       String?
  code           String   @unique
  partnerId      String
  invoiceId      String?
  date           DateTime @default(now())
  reason         String?
  status         String   @default("draft")
  subtotal       Float    @default(0)
  taxTotal       Float    @default(0)
  total          Float    @default(0)
  journalEntryId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner Partner                  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines   PurchaseCreditNoteLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([invoiceId])
  @@index([status])
  @@index([journalEntryId])
}

model PurchasePayment {
  // Payment voucher (سند صرف)
  id             String   @id @default(cuid())
  companyId      String
  branchId       String?
  code           String   @unique // PV-YYYY-000001
  partnerId      String
  invoiceId      String?
  amount         Float
  paymentDate    DateTime @default(now())
  method         String   @default("cash") // cash|card|transfer|check
  reference      String?
  bankAccountId  String?
  safeId         String?
  journalEntryId String?
  status         String   @default("draft") // draft|posted|cancelled|reversed
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([invoiceId])
  @@index([bankAccountId])
  @@index([safeId])
  @@index([journalEntryId])
  @@index([status])
}

// =============================================================================
// INVENTORY OPERATIONS — Delivery, Transfer, Adjustment
// =============================================================================

model Delivery {
  id             String   @id @default(cuid())
  companyId      String
  branchId       String?
  code           String   @unique
  salesOrderId   String?
  partnerId      String?
  warehouseId    String
  deliveryDate   DateTime @default(now())
  status         String   @default("draft") // draft|waiting|picked|packed|done|cancelled
  journalEntryId String?
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id])
  salesOrder SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  partner    Partner?       @relation(fields: [partnerId], references: [id])
  lines      DeliveryLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([salesOrderId])
  @@index([partnerId])
  @@index([warehouseId])
  @@index([status])
  @@index([journalEntryId])
}

model DeliveryLine {
  id               String  @id @default(cuid())
  deliveryId       String
  productId        String
  salesOrderLineId String?
  orderedQty       Float
  deliveredQty     Float
  lotId            String?
  uomId            String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([deliveryId])
  @@index([productId])
  @@index([salesOrderLineId])
  @@index([lotId])
  @@index([uomId])
}

model StockTransfer {
  id              String   @id @default(cuid())
  companyId       String
  code            String   @unique // ST-YYYY-000001
  fromWarehouseId String
  toWarehouseId   String
  transferDate    DateTime @default(now())
  status          String   @default("draft") // draft|approved|picked|in_transit|received|done|cancelled
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromWarehouse Warehouse           @relation("TransferFromWH", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferToWH", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@index([companyId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

model StockTransferLine {
  id         String  @id @default(cuid())
  transferId String
  productId  String
  quantity   Float
  doneQty    Float   @default(0)
  uomId      String?
  lotId      String?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@index([uomId])
  @@index([lotId])
}

model InventoryAdjustment {
  id             String   @id @default(cuid())
  companyId      String
  code           String   @unique // IA-YYYY-000001
  warehouseId    String
  adjustmentDate DateTime @default(now())
  reason         String?
  reasonCodeId   String?
  status         String   @default("draft") // draft|counted|approved|posted|cancelled
  journalEntryId String?
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  warehouse  Warehouse                 @relation(fields: [warehouseId], references: [id])
  reasonCode ReasonCode?               @relation(fields: [reasonCodeId], references: [id])
  lines      InventoryAdjustmentLine[]

  @@index([companyId])
  @@index([warehouseId])
  @@index([reasonCodeId])
  @@index([status])
  @@index([journalEntryId])
}

model InventoryAdjustmentLine {
  id           String  @id @default(cuid())
  adjustmentId String
  productId    String
  systemQty    Float
  countedQty   Float
  variance     Float
  unitCost     Float
  lotId        String?

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
  @@index([lotId])
}

// =============================================================================
// MANUFACTURING — BOM, Routing, Production Order
// =============================================================================

model Bom {
  id        String   @id @default(cuid())
  companyId String
  code      String   @unique
  nameAr    String
  nameEn    String?
  productId String // finished product
  quantity  Float    @default(1)
  version   Int      @default(1)
  status    String   @default("draft") // draft|approved|archived
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id])
  components       BomComponent[]
  productionOrders ProductionOrder[]

  @@index([companyId])
  @@index([productId])
  @@index([status])
}

model BomComponent {
  id           String  @id @default(cuid())
  bomId        String
  productId    String
  quantity     Float
  uomId        String?
  scrapPercent Float   @default(0)

  bom     Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([bomId])
  @@index([productId])
  @@index([uomId])
}

model WorkCenter {
  id              String  @id @default(cuid())
  code            String  @unique
  nameAr          String
  nameEn          String?
  capacityPerHour Float   @default(0)
  costPerHour     Float   @default(0)
  active          Boolean @default(true)
}

model ProductionOrder {
  id             String    @id @default(cuid())
  companyId      String
  branchId       String?
  code           String    @unique // MO-YYYY-000001
  bomId          String
  productId      String
  quantity       Float
  producedQty    Float     @default(0)
  scrapQty       Float     @default(0)
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  status         String    @default("draft") // draft|planned|released|in_progress|produced|costed|closed|cancelled
  totalCost      Float     @default(0)
  journalEntryId String?
  notes          String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bom     Bom     @relation(fields: [bomId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  creator User?   @relation("ProductionOrderCreator", fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([bomId])
  @@index([productId])
  @@index([status])
  @@index([journalEntryId])
}

// =============================================================================
// HUMAN RESOURCES — Employee, Contract, Attendance, Leave, Payroll
// =============================================================================

model Employee {
  id              String    @id @default(cuid())
  employeeNo      String    @unique
  nameAr          String
  nameEn          String?
  companyId       String
  branchId        String?
  departmentId    String?
  orgStructureId  String?
  jobPositionId   String?
  partnerId       String? // linked business partner
  hireDate        DateTime?
  terminationDate DateTime?
  status          String    @default("active") // active|suspended|terminated
  nationalId      String?
  passportNo      String?
  phone           String?
  email           String?
  address         String?
  birthDate       DateTime?
  gender          String?
  nationality     String?
  userId          String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User?          @relation(fields: [userId], references: [id])
  department      Department?    @relation(fields: [departmentId], references: [id])
  orgStructure    OrgStructure?  @relation("OrgUnitEmployees", fields: [orgStructureId], references: [id])
  managedOrgUnits OrgStructure[] @relation("OrgUnitManager")
  jobPosition     JobPosition?   @relation(fields: [jobPositionId], references: [id])
  contracts       Contract[]
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  payslips        Payslip[]

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([orgStructureId])
  @@index([jobPositionId])
  @@index([partnerId])
  @@index([status])
  @@index([nationalId])
}

model Department {
  id        String  @id @default(cuid())
  code      String  @unique
  nameAr    String
  nameEn    String?
  parentId  String?
  managerId String?
  active    Boolean @default(true)

  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")

  employees Employee[]

  @@index([parentId])
  @@index([managerId])
}

model JobPosition {
  id     String  @id @default(cuid())
  code   String  @unique
  nameAr String
  nameEn String?
  active Boolean @default(true)

  employees Employee[]
}

model Contract {
  id         String    @id @default(cuid())
  employeeId String
  startDate  DateTime
  endDate    DateTime?
  baseSalary Float     @default(0)
  allowances Float     @default(0)
  currencyId String?
  status     String    @default("active") // active|expired|terminated
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([currencyId])
  @@index([status])
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("present") // present|absent|late|leave|holiday
  notes      String?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
}

model LeaveRequest {
  id         String    @id @default(cuid())
  employeeId String
  leaveType  String    @default("annual") // annual|sick|emergency|unpaid
  startDate  DateTime
  endDate    DateTime
  days       Float
  status     String    @default("draft") // draft|submitted|approved|rejected
  reason     String?
  approverId String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([status])
  @@index([approverId])
}

model PayrollRun {
  id              String   @id @default(cuid())
  companyId       String
  period          String // YYYY-MM
  startDate       DateTime
  endDate         DateTime
  status          String   @default("draft") // draft|calculated|reviewed|approved|posted|paid|cancelled
  totalGross      Float    @default(0)
  totalDeductions Float    @default(0)
  totalNet        Float    @default(0)
  journalEntryId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payslips Payslip[]

  @@index([companyId])
  @@index([status])
  @@index([journalEntryId])
}

model Payslip {
  id           String   @id @default(cuid())
  payrollRunId String
  employeeId   String
  code         String   @unique // PAY-YYYY-000001
  grossSalary  Float    @default(0)
  allowances   Float    @default(0)
  deductions   Float    @default(0)
  netSalary    Float    @default(0)
  status       String   @default("draft") // draft|calculated|posted|paid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([payrollRunId])
  @@index([employeeId])
  @@index([status])
}

// =============================================================================
// RETURNS — Sales Return (مرتجع مبيعات) + Purchase Return (مرتجع مشتريات)
// =============================================================================

model SalesReturn {
  id                String   @id @default(cuid())
  companyId         String
  branchId          String?
  code              String   @unique // SR-YYYY-NNNNN
  partnerId         String
  originalInvoiceId String? // linked SalesInvoice.id (no FK to allow independent lifecycle)
  date              DateTime @default(now())
  reason            String?
  status            String   @default("draft") // draft|approved|received|credited|closed|cancelled
  subtotal          Float    @default(0)
  taxTotal          Float    @default(0)
  total             Float    @default(0)
  journalEntryId    String? // reversal journal entry created on "credit"
  notes             String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  partner Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines   SalesReturnLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([originalInvoiceId])
  @@index([status])
  @@index([journalEntryId])
}

model SalesReturnLine {
  id          String  @id @default(cuid())
  returnId    String
  productId   String
  description String?
  quantity    Float
  uomId       String?
  unitPrice   Float
  taxRate     Float   @default(0)
  total       Float   @default(0)

  return  SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([uomId])
}

model PurchaseReturn {
  id                String   @id @default(cuid())
  companyId         String
  branchId          String?
  code              String   @unique // PR-YYYY-NNNNN
  partnerId         String
  originalInvoiceId String? // linked PurchaseInvoice.id
  date              DateTime @default(now())
  reason            String?
  status            String   @default("draft") // draft|approved|shipped|debited|closed|cancelled
  subtotal          Float    @default(0)
  taxTotal          Float    @default(0)
  total             Float    @default(0)
  journalEntryId    String? // reversal journal entry created on "debit"
  notes             String?
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  partner Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines   PurchaseReturnLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([originalInvoiceId])
  @@index([status])
  @@index([journalEntryId])
}

model PurchaseReturnLine {
  id          String  @id @default(cuid())
  returnId    String
  productId   String
  description String?
  quantity    Float
  uomId       String?
  unitCost    Float
  taxRate     Float   @default(0)
  total       Float   @default(0)

  return  PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])

  @@index([returnId])
  @@index([productId])
  @@index([uomId])
}

model Activity {
  id        String   @id @default(cuid())
  name      String
  code      String?
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  branchId      String?
  code          String   @unique
  date          DateTime @default(now())
  amount        Float
  payee         String?
  category      String
  reference     String?
  note          String?
  status        String   @default("posted")
  bankAccountId String?
  safeId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?      @relation(fields: [branchId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  safe        Safe?        @relation(fields: [safeId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([bankAccountId])
  @@index([safeId])
}

model Revenue {
  id            String   @id @default(cuid())
  companyId     String
  branchId      String?
  code          String   @unique
  date          DateTime @default(now())
  amount        Float
  payee         String?
  category      String
  reference     String?
  note          String?
  status        String   @default("posted")
  bankAccountId String?
  safeId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch?      @relation(fields: [branchId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  safe        Safe?        @relation(fields: [safeId], references: [id])

  @@index([companyId])
  @@index([branchId])
  @@index([status])
  @@index([bankAccountId])
  @@index([safeId])
}

model SalesCreditNoteLine {
  id              String  @id @default(cuid())
  creditNoteId    String
  productId       String
  description     String?
  quantity        Float
  uomId           String?
  unitPrice       Float
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  taxCodeId       String?
  taxRate         Float   @default(0)
  total           Float   @default(0)

  creditNote SalesCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@index([creditNoteId])
  @@index([productId])
}

model PurchaseCreditNoteLine {
  id              String  @id @default(cuid())
  creditNoteId    String
  productId       String
  description     String?
  quantity        Float
  uomId           String?
  unitCost        Float
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  taxCodeId       String?
  taxRate         Float   @default(0)
  total           Float   @default(0)

  creditNote PurchaseCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product            @relation(fields: [productId], references: [id])

  @@index([creditNoteId])
  @@index([productId])
}

