  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([salesOrderId])
  @@index([journalId])
  @@index([currencyId])
  @@index([paymentTermId])
  @@index([status])
  @@index([journalEntryId])
}

model SalesInvoiceLine {
