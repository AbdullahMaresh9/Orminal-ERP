// =============================================================================
// SALES — Quotation, Order, Invoice, Credit Note, Payment
// =============================================================================

model SalesQuotation {
  id                    String    @id @default(cuid())
  companyId             String
  branchId              String?
  code                  String    @unique // SQ-YYYY-000001
  partnerId             String
  quotationDate         DateTime  @default(now())
  validUntil            DateTime?
  priceListId           String?
  currencyId            String?
  paymentTermId         String?
  status                String    @default("draft") // draft|sent|accepted|expired|cancelled|converted
  subtotal              Float     @default(0)
  taxTotal              Float     @default(0)
  discount              Float     @default(0)
  total                 Float     @default(0)
  notes                 String?
  createdBy             String?
  convertedSalesOrderId String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  partner Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines   SalesQuotationLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([priceListId])
  @@index([currencyId])
  @@index([paymentTermId])
  @@index([status])
  @@index([convertedSalesOrderId])
}

model SalesQuotationLine {
  id              String  @id @default(cuid())
  quotationId     String
  productId       String
  description     String?
  quantity        Float
  uomId           String?
  unitPrice       Float
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  taxCodeId       String?
  taxRate         Float   @default(0)
  total           Float   @default(0)

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@index([uomId])
  @@index([taxCodeId])
}

model SalesOrder {
  id             String    @id @default(cuid())
  companyId      String
  branchId       String?
  code           String    @unique // SO-YYYY-000001
  partnerId      String
  quotationId    String?
  orderDate      DateTime  @default(now())
  requiredDate   DateTime?
  priceListId    String?
  currencyId     String?
  paymentTermId  String?
  warehouseId    String?
  salespersonId  String?
  deliveryStatus String    @default("pending") // pending|partial|delivered
  invoiceStatus  String    @default("pending") // pending|partial|invoiced
  paymentStatus  String    @default("unpaid") // unpaid|partial|paid
  creditStatus   String    @default("ok") // ok|warning|blocked
  status         String    @default("draft") // draft|confirmed|partially_delivered|delivered|invoiced|paid|closed|cancelled
  subtotal       Float     @default(0)
  taxTotal       Float     @default(0)
  discount       Float     @default(0)
  total          Float     @default(0)
  paid           Float     @default(0)
  notes          String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  partner    Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  creator    User?            @relation("SalesOrderCreator", fields: [createdBy], references: [id])
  lines      SalesOrderLine[]
  deliveries Delivery[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([quotationId])
  @@index([priceListId])
  @@index([currencyId])
  @@index([paymentTermId])
  @@index([warehouseId])
  @@index([salespersonId])
  @@index([status])
}

model SalesOrderLine {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  description     String?
  quantity        Float
  deliveredQty    Float   @default(0)
  invoicedQty     Float   @default(0)
  uomId           String?
  unitPrice       Float
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  taxCodeId       String?
  taxRate         Float   @default(0)
  total           Float   @default(0)

  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([uomId])
  @@index([taxCodeId])
}

model SalesInvoice {
  id             String    @id @default(cuid())
  companyId      String
  branchId       String?
  code           String    @unique // INV-YYYY-000001
  partnerId      String
  salesOrderId   String?
  invoiceDate    DateTime  @default(now())
  dueDate        DateTime?
  journalId      String?
  currencyId     String?
  paymentTermId  String?
  status         String    @default("draft") // draft|posted|partially_paid|paid|overdue|reversed|cancelled
  subtotal       Float     @default(0)
  taxTotal       Float     @default(0)
  discount       Float     @default(0)
  total          Float     @default(0)
  paid           Float     @default(0)
  journalEntryId String?
  notes          String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  partner Partner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
