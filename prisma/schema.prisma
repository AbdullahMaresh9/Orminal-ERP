  invoiceId       String
  productId       String
  description     String?
  quantity        Float
  uomId           String?
  unitPrice       Float
  discountPercent Float   @default(0)
  discountAmount  Float   @default(0)
  taxCodeId       String?
  taxRate         Float   @default(0)
  total           Float   @default(0)

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([uomId])
  @@index([taxCodeId])
}

model SalesCreditNote {
  id             String   @id @default(cuid())
  companyId      String
  branchId       String?
  code           String   @unique // CN-YYYY-000001
  partnerId      String
  invoiceId      String?
  date           DateTime @default(now())
  reason         String?
  status         String   @default("draft") // draft|posted|cancelled
  subtotal       Float    @default(0)
  taxTotal       Float    @default(0)
  total          Float    @default(0)
  journalEntryId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  partner Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines   SalesCreditNoteLine[]

  @@index([companyId])
  @@index([branchId])
  @@index([partnerId])
  @@index([invoiceId])
  @@index([status])
  @@index([journalEntryId])
}

model SalesPayment {
  // Receipt voucher (سند قبض)
  id             String   @id @default(cuid())
  companyId      String
  branchId       String?
  code           String   @unique // RV-YYYY-000001
  partnerId      String
  invoiceId      String?
  amount         Float
  paymentDate    DateTime @default(now())
  method         String   @default("cash") // cash|card|transfer|check
  reference      String?
  bankAccountId  String?
  safeId         String?
  journalEntryId String?
  status         String   @default("draft") // draft|posted|cancelled|reversed
  notes          String?
  createdBy      String?
