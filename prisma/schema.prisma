  updatedAt  DateTime @updatedAt

  account  Account?  @relation(fields: [accountId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])
  expenses Expense[]
  revenues Revenue[]

  @@index([companyId])
  @@index([branchId])
  @@index([currencyId])
  @@index([accountId])
