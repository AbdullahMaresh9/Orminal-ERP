  @@index([branchId])
  @@index([partnerId])
  @@index([invoiceId])
  @@index([bankAccountId])
  @@index([safeId])
  @@index([journalEntryId])
  @@index([status])
}

// =============================================================================
// PROCUREMENT — PR, RFQ, PO, Goods Receipt, Vendor Bill, Payment
// =============================================================================

model PurchaseRequest {
